<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Original TCP + protobuf-net communication framework, spliced together as-is from the legacy source.
    Nullable and implicit usings are off on purpose so the code stays as close to the original as possible.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>LabOriginal.Neutron</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageReference Include="protobuf-net" Version="3.2.56" />
  </ItemGroup>
</Project>
